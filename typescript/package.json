{
  "name": "lorebo-sdk",
  "version": "0.1.0",
  "description": "Save and retrieve Lorebo knowledge from your application with any LLM",
  "license": "MIT",
  "author": "LexRAG",
  "homepage": "https://github.com/lexrag/lorebo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexrag/lorebo-sdk.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/lexrag/lorebo-sdk/issues",
  "keywords": [
    "lorebo",
    "knowledge-base",
    "mcp",
    "llm",
    "agents",
    "ai-sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lorebo.d.ts",
      "import": "./dist/lorebo.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "import": "./dist/records.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --config .prettierrc.json --write . ../README.md ../docs",
    "format:check": "prettier --config .prettierrc.json --check . ../README.md ../docs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepack": "npm run build && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('../README.md', 'README.md'); copyFileSync('../LICENSE', 'LICENSE');\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.2",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.31",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "ai": "^7.0.148",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
